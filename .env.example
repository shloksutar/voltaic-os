# VoltaicOS Supabase Configuration
# Obtain these values from your Supabase Project Settings -> API:
# https://supabase.com/dashboard/project/_/settings/api

# Frontend Vite variables (accessible in the browser via import.meta.env)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Backend Node server variables (if running server/index.js)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
SUPABASE_ANON_KEY=your-anon-public-key-here
PORT=5000

# Production security configuration (keep server-only values out of VITE_* vars)
# NODE_ENV=production
# SESSION_SECRET=replace-with-at-least-32-random-characters
# ADMIN_EMAILS=admin@your-real-domain.example
# CORS_ORIGINS=https://your-real-domain.example
# RELEASE_ID=2026-11-03-green
# DB_BACKUP_DIR=/secure/private/voltaic-backups
# DB_BACKUP_ENCRYPTION_KEY=replace-with-a-secret-managed-by-your-vault
# DB_BACKUP_RETENTION_DAYS=14
# ALERT_WEBHOOK_URL=https://your-alert-webhook.example
# ALLOW_JSON_DB=false

# Optional rate limit overrides (requests per window, per client IP)
# RATE_LIMIT_API_MAX=300   # general API requests per 15 min
# RATE_LIMIT_AUTH_MAX=20   # auth requests per 15 min
# RATE_LIMIT_LOGIN_MAX=5   # failed login attempts per 15 min
# RATE_LIMIT_OTP_MAX=8     # OTP send/verify requests per 10 min
# RATE_LIMIT_WRITE_MAX=40  # booking/report/listing/alert submissions per 15 min

# Comma-separated admin emails (server-side only, never exposed to the browser)
# ADMIN_EMAILS=you@example.com,ops@example.com
